      "label": "build active cpp (debug)",
      "type": "shell",
      "command": "mkdir -p \"${workspaceFolder}/build/debug\" && /usr/bin/clang++ -std=c++23 -g -O0 -Wall -Wextra \"${file}\" -o \"${workspaceFolder}/build/debug/${fileBasenameNoExtension}\"",
